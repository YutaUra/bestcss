{
  "name": "@best-css/vite-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./route-css": {
      "types": "./dist/route-css.d.ts",
      "default": "./dist/route-css.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@best-css/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "vite": "^8.1.3"
  }
}
