{
  "name": "@bestcss/vite-plugin",
  "version": "0.1.2",
  "description": "bestcss の Vite プラグイン。css`` の抽出・HMR・クラス名短縮・SSR / ルート単位 CSS 分割",
  "keywords": [
    "css",
    "css-in-js",
    "zero-runtime",
    "bestcss"
  ],
  "license": "MIT",
  "author": "Yuta Ura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YutaUra/bestcss.git",
    "directory": "packages/vite-plugin"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./route-css": {
      "types": "./dist/route-css.d.ts",
      "default": "./dist/route-css.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bestcss/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "vite": "^8.1.3",
    "vite6": "npm:vite@^6.4.3"
  }
}
